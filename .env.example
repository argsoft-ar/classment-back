NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://classment:classment_pass@localhost:5433/classment
# Required. At least 32 chars; the server refuses to start with a placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
