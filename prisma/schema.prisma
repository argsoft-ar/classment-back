generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum LevelType {
  TERTIARY
}

enum UserRole {
  SuperAdmin
  Directivo
  Docente
  Alumno
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum SubjectRegime {
  ANNUAL
}

enum CorrelativeScope {
  CURSADA
  FINAL
}

enum RequiredStatus {
  REGULARIZADA
  APROBADA
}

enum AcademicStatus {
  CURSANDO
  REGULARIZADA
  APROBADA
  DESAPROBADA
  LIBRE
}

enum RecordOrigin {
  CURSADA
  FINAL
  EQUIVALENCIA
  CARGA_INICIAL
}

enum PeriodType {
  CURSADA
  FINAL
}

enum EnrollmentModality {
  REGULAR
  LIBRE
}

enum EnrollmentStatus {
  ACTIVA
  BAJA
  CERRADA
}

enum EnrollmentResult {
  REGULARIZADA
  APROBADA
  DESAPROBADA
  AUSENTE
}

// ── Models ───────────────────────────────────────────────────────────────────

/// Single configuration row: the system serves one institution.
model Institution {
  id                        String    @id @default(cuid())
  name                      String
  cue                       String    @unique
  address                   String
  levelType                 LevelType @default(TERTIARY)
  allowsPromotion           Boolean   @default(false)
  passingGrade              Int       @default(4)
  promotionGrade            Int?
  validateFinalCorrelatives Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  /// Null while the user is INVITED and has not defined a password yet.
  password  String?
  dni       String     @unique
  firstName String
  lastName  String
  role      UserRole
  status    UserStatus @default(INVITED)
  /// Embedded in the JWT as `tv`; incrementing it revokes every previously issued token.
  tokenVersion Int     @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  studentCareers  StudentCareer[]
  academicRecords AcademicRecord[]
  taughtOfferings Offering[]       @relation("OfferingTeacher")
  enrollments     Enrollment[]

  @@index([role])
}

model Career {
  id            String   @id @default(cuid())
  name          String
  durationYears Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  studyPlans StudyPlan[]
}

model StudyPlan {
  id        String   @id @default(cuid())
  careerId  String
  code      String
  year      Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  career         Career          @relation(fields: [careerId], references: [id], onDelete: Cascade)
  subjects       Subject[]
  studentCareers StudentCareer[]

  @@unique([careerId, code])
}

model Subject {
  id          String        @id @default(cuid())
  studyPlanId String
  name        String
  yearLevel   Int
  regime      SubjectRegime @default(ANNUAL)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  studyPlan       StudyPlan         @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  correlatives    CorrelativeRule[] @relation("SubjectCorrelatives")
  requiredBy      CorrelativeRule[] @relation("RequiredSubject")
  academicRecords AcademicRecord[]
  offerings       Offering[]

  @@index([studyPlanId, yearLevel])
}

model CorrelativeRule {
  id                String           @id @default(cuid())
  subjectId         String
  requiredSubjectId String
  appliesTo         CorrelativeScope
  requiredStatus    RequiredStatus
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  subject         Subject @relation("SubjectCorrelatives", fields: [subjectId], references: [id], onDelete: Cascade)
  requiredSubject Subject @relation("RequiredSubject", fields: [requiredSubjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, requiredSubjectId, appliesTo])
}

model StudentCareer {
  id          String   @id @default(cuid())
  studentId   String
  studyPlanId String
  cohortYear  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id])

  @@unique([studentId, studyPlanId])
}

model AcademicRecord {
  id            String         @id @default(cuid())
  studentId     String
  subjectId     String
  status        AcademicStatus
  origin        RecordOrigin
  finalGrade    Decimal?       @db.Decimal(4, 2)
  regularizedAt DateTime?
  approvedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId])
}

model EnrollmentPeriod {
  id           String     @id @default(cuid())
  type         PeriodType
  name         String
  academicYear Int
  /// Null for CURSADA periods; 1 or 2 for FINAL periods.
  callNumber   Int?
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  offerings Offering[]
}

model Offering {
  id          String    @id @default(cuid())
  periodId    String
  subjectId   String
  teacherId   String?
  examDate    DateTime?
  maxCapacity Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  period      EnrollmentPeriod @relation(fields: [periodId], references: [id])
  subject     Subject          @relation(fields: [subjectId], references: [id])
  teacher     User?            @relation("OfferingTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]

  @@unique([periodId, subjectId])
}

/// A partial unique index (offeringId, studentId) WHERE status = 'ACTIVA' is added via SQL migration.
model Enrollment {
  id         String             @id @default(cuid())
  offeringId String
  studentId  String
  modality   EnrollmentModality @default(REGULAR)
  status     EnrollmentStatus   @default(ACTIVA)
  grade      Decimal?           @db.Decimal(4, 2)
  result     EnrollmentResult?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  offering Offering @relation(fields: [offeringId], references: [id])
  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([offeringId, studentId])
}
